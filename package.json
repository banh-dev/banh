{
  "name": "banh-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "dev": "tsx packages/cli/src/index.ts",
    "test:integration": "pnpm build && LAYA_INTEGRATION=1 vitest run test/laya.integration.test.ts",
    "release:check": "pnpm build && node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@banh/dsl": "workspace:*",
    "@banh/runtime": "workspace:*",
    "@banh/laya": "workspace:*",
    "@receptron/laya": "^0.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "@banh/providers": "workspace:*",
    "@banh/typesafe": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3"
    }
  }
}
